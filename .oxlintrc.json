{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "plugins": [
    "typescript",
    "react",
    "oxc",
    "unicorn"
  ],
  "ignorePatterns": [
    "src/mygo.ts",
    "dist",
    "build",
    ".mygo"
  ],
  "overrides": [
    {
      "files": [
        "src/components/transcript.tsx"
      ],
      "rules": {
        "react/incompatible-library": "off"
      }
    }
  ]
}
